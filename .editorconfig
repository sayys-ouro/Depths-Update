# EditorConfig is awesome: https://editorconfig.org

# top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.bat]
end_of_line = crlf

[*.{jar,png}]
charset = unset

[{*.{json,md,toml,yaml,yml},mcmod.info,pack.mcmeta}]
indent_size = 2
